day = int(input())
month = int(input())
year = int(input())

# Check leap year
leap = False
if (year % 400 == 0) or (year % 4 == 0 and year % 100 != 0):
	leap = True

# Days in each month
days = [31,29 if leap else 28,31,30,31,30,31,31,30,31,30,31]

# Validate date
if year <= 0 or month < 1 or month > 12 or day < 1 or day > days[month-1]:
	print("Invalid Date")
else:
	day += 1
	if day > days[month-1]:
		day = 1
		month += 1
		if month > 12:
			month = 1
			year += 1

	print(f"{day:02d}-{month:02d}-{year}")
